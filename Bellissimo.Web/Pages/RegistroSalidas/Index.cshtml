@page
@model Bellissimo.Web.Pages.RegistroSalidas.IndexModel
@{
    ViewData["Title"] = "Registro de Salidas";
}

<div class="container py-4">
    <h1>Registro de Salidas</h1>

    <div class="row g-3 mt-2">
        <div class="col-md-6 col-lg-5">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3 class="card-title">Salida del Turno</h3>
                    <p class="card-text">Registra las salidas del personal al final del día.</p>
                    <a asp-page="/RegistroSalidas/RegistroSalida" class="btn btn-primary">
                        Ir a Salida del Turno
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-5">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3 class="card-title">Regreso de Comida</h3>
                    <p class="card-text">Registra el regreso del personal despues de su comida.</p>
                    <a asp-page="/RegistroSalidas/RegistroSalidaComida" class="btn btn-primary">
                        Ir a Regreso de Comida
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>