<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>document.documentElement.classList.add('js')</script>
    <title>@ViewData["Title"] - Bellissimo</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Bellissimo.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm mb-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-4" asp-area="" asp-page="/Index">
                    <img src="~/img/logoBellissimo.png" alt="Logo Bellissimo" style="height: 60px; width: auto;" />
                    Bellissimo
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">Inicio</a>
                        </li>
                        <li class="nav-item has-submenu">
                            <a class="nav-link" asp-page="/RegistroEntradas/Index">Entradas</a>
                            <div class="submenu-horizontal">
                                <a href="/RegistroEntradas/RegistroEntrada">Entrada</a>
                                <a href="/RegistroEntradas/RegistroRegresoComida">Regreso</a>
                            </div>
                        </li>
                        <li class="nav-item has-submenu">
                            <a class="nav-link" asp-page="/RegistroSalidas/Index">Salidas</a>
                            <div class="submenu-horizontal">
                                <a href="/RegistroSalidas/RegistroSalida">Salida</a>
                                <a href="/RegistroSalidas/RegistroSalidaComida">Comida</a>
                            </div>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Pagos/Index">Pagos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Personal/Index">Personal</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Bellissimo.Web - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>