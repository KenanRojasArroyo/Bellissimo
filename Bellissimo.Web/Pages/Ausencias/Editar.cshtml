@page "{id:int}"
@model Bellissimo.Web.Pages.Ausencias.EditarModel
@{
    ViewData["Title"] = "Editar Ausencia";
}

<div class="container-fluid mx-auto py-4 contenedor-ajustable">
    <h1 class="mb-4">Editar Ausencia</h1>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger">@Model.Error</div>
        <a asp-page="./Index" class="btn btn-outline-secondary">Regresar</a>
    }
    else if (Model.Ausencia.SemanaCerrada)
    {
        <div class="alert alert-warning">
            Esta ausencia pertenece a una semana cerrada y se muestra en modo de solo lectura.
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Empleado</label>
                    <input value="@Model.Ausencia.NombreEmpleado" class="form-control" disabled />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Fecha</label>
                    <input value="@Model.Ausencia.Fecha.ToString("dd/MM/yyyy")" class="form-control" disabled />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Tipo</label>
                    <input value="@Model.Ausencia.Tipo" class="form-control" disabled />
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Observaciones</label>
                    <textarea class="form-control" rows="2" disabled>@Model.Ausencia.Observaciones</textarea>
                </div>
                <div class="col-12 mt-4">
                    <a asp-page="./Index" class="btn btn-outline-secondary">Regresar</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <form method="post" class="row g-3">
                    <input type="hidden" asp-for="Ausencia.IdAusencia" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="col-md-6">
                        <label asp-for="Ausencia.IdEmpleado" class="form-label">Empleado</label>
                        <select asp-for="Ausencia.IdEmpleado" asp-items="Model.ListaEmpleados" class="form-select">
                            <option value="0">Seleccione un empleado...</option>
                        </select>
                        <span asp-validation-for="Ausencia.IdEmpleado" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Ausencia.Fecha" class="form-label">Fecha</label>
                        <input asp-for="Ausencia.Fecha" type="date" class="form-control" />
                        <span asp-validation-for="Ausencia.Fecha" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Ausencia.Tipo" class="form-label">Tipo de ausencia</label>
                        <select asp-for="Ausencia.Tipo" asp-items="Model.ListaTipos" class="form-select">
                            <option value="">Seleccione un tipo...</option>
                        </select>
                        <span asp-validation-for="Ausencia.Tipo" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Ausencia.Observaciones" class="form-label">Observaciones (opcional)</label>
                        <textarea asp-for="Ausencia.Observaciones" class="form-control" rows="2" maxlength="200"></textarea>
                        <span asp-validation-for="Ausencia.Observaciones" class="text-danger"></span>
                    </div>

                    <div class="col-12 mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-outline-primary">Guardar cambios</button>
                        <a asp-page="./Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}