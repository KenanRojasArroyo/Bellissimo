@page
@model Bellissimo.Web.Pages.Ausencias.IndexModel
@{
    ViewData["Title"] = "Registro de Ausencias";
}

<div class="container-fluid mx-auto py-4 contenedor-ajustable">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Registro de Ausencias</h1>
        <a asp-page="./Nuevo" class="btn btn-primary">
            Nueva ausencia
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger">@Model.Error</div>
    }

    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="alert alert-success">@mensaje</div>
    }

    <form method="get" class="row g-2 align-items-end mb-4">
        <div class="col-md-4">
            <label asp-for="IdEmpleado" class="form-label">Empleado</label>
            <select asp-for="IdEmpleado" asp-items="Model.ListaEmpleados" class="form-select">
                <option value="">Todos los empleados</option>
            </select>
        </div>
        <div class="col-md-2">
            <label asp-for="Desde" class="form-label">Desde</label>
            <input asp-for="Desde" type="date" class="form-control" />
        </div>
        <div class="col-md-2">
            <label asp-for="Hasta" class="form-label">Hasta</label>
            <input asp-for="Hasta" type="date" class="form-control" />
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-fill">Filtrar</button>
            <a asp-page="./Index" class="btn btn-outline-secondary flex-fill">Limpiar</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Empleado</th>
                    <th>Tipo</th>
                    <th>Observaciones</th>
                    <th>Semana</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ListaAusencias)
                {
                    <tr>
                        <td class="fw-semibold">@item.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@item.NombreEmpleado</td>
                        <td>
                            @if (item.Tipo == "Injustificada")
                            {
                                <span class="badge bg-danger">@item.Tipo</span>
                            }
                            else if (item.Tipo == "Vacaciones")
                            {
                                <span class="badge bg-info text-dark">@item.Tipo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@item.Tipo</span>
                            }
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(item.Observaciones) ? "-" : item.Observaciones)</td>
                        <td>
                            @if (item.SemanaCerrada)
                            {
                                <span class="badge bg-dark">Cerrada (Solo lectura)</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Abierta</span>
                            }
                        </td>
                        <td>
                            @if (!item.SemanaCerrada)
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    <a asp-page="./Editar"
                                       asp-route-id="@item.IdAusencia"
                                       class="btn btn-sm btn-outline-secondary">Editar</a>

                                    <a asp-page="./Eliminar"
                                       asp-route-id="@item.IdAusencia"
                                       class="btn btn-sm btn-outline-danger">Eliminar</a>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted small">Sin acciones</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>