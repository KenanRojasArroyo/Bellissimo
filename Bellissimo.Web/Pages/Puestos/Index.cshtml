@page
@model Bellissimo.Web.Pages.Puestos.IndexModel
@{
    ViewData["Title"] = "Catálogo de Puestos";
}

<div class="container-fluid mx-auto py-4 contenedor-ajustable">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Catálogo de Puestos</h1>
        <a asp-page="./Nuevo" class="btn btn-primary">
            Nuevo puesto
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger">@Model.Error</div>
    }

    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="alert alert-success">@mensaje</div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre del puesto</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var puesto in Model.ListaPuestos)
                {
                    <tr>
                        <td class="fw-semibold">#@puesto.IdPuesto</td>
                        <td>@puesto.Nombre</td>
                        <td>
                            <a asp-page="./Editar"
                               asp-route-id="@puesto.IdPuesto"
                               class="btn btn-sm btn-outline-secondary">Editar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>