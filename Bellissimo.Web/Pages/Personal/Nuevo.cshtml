@page
@model Bellissimo.Web.Pages.Personal.NuevoModel
@using Bellissimo.Entidades
@{
    ViewData["Title"] = "Nuevo Empleado";

}

<div class="container py-4">
    <h1>Nuevo Empleado</h1>

    <form method="post" class="row g-3">
        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <div class="col-md-6">
            <label asp-for="Empleado.Nombre" class="form-label"></label>
            <input asp-for="Empleado.Nombre" class="form-control" />
            <span asp-validation-for="Empleado.Nombre"
                  class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Empleado.ApellidoPaterno"
                   class="form-label">Apellido paterno</label>
            <input asp-for="Empleado.ApellidoPaterno" class="form-control" />
            <span asp-validation-for="Empleado.ApellidoPaterno"
                  class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Empleado.ApellidoMaterno"
                   class="form-label">Apellido materno</label>
            <input asp-for="Empleado.ApellidoMaterno" class="form-control" />
        </div>

        <div class="col-md-6">
            <label asp-for="Empleado.Telefono"
                   class="form-label">Teléfono</label>
            <input asp-for="Empleado.Telefono" class="form-control" />
            <span asp-validation-for="Empleado.Telefono"
                  class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Empleado.TipoCargo" class="form-label">Cargo</label>
            <select asp-for="Empleado.TipoCargo" class="form-select">
                @foreach (var cargo in Enum.GetValues<TipoCargo>())
                {
                    <option value="@cargo">@cargo.ObtenerNombreAmigable()</option>
                }
            </select>
            <span asp-validation-for="Empleado.TipoCargo" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Empleado.SueldoBase" class="form-label">Sueldo Base / hr</label>
            <input asp-for="Empleado.SueldoBase" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="Empleado.SueldoBase" class="text-danger"></span>
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}