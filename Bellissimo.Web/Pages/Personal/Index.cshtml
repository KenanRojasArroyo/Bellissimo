@page
@using Bellissimo.Entidades
@model Bellissimo.Web.Pages.Personal.IndexModel
@{
    ViewData["Title"] = "Ajustes de Personal";
}

<div class="container-fluid mx-auto py-4" style="width: 80%; max-width: 1400px;">
    
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Ajustes de Personal</h1>
        <a asp-page="./Nuevo" class="btn btn-primary">
            Nuevo empleado
        </a>
    </div>

    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="alert alert-success">@mensaje</div>
    }

    <form method="get" class="d-flex gap-2 mb-4">
        <div class="flex-grow-1">
            <input asp-for="Buscar"
                   class="form-control border-0 shadow-sm"
                   placeholder="Buscar por nombre..." />
        </div>
        <button type="submit" class="btn btn-outline-primary">
            Buscar
        </button>
        <a asp-page="./Index" class="btn btn-outline-secondary">
            Limpiar
        </a>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Teléfono</th>
                    <th>Cargo</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var personal in Model.ListaPersonal)
                {
                    <tr>
                        <td>
                            @personal.Nombre @personal.ApellidoPaterno @personal.ApellidoMaterno
                        </td>
                        <td>@personal.Telefono</td>
                        <td>@personal.TipoCargo.ObtenerNombreAmigable()</td>
                        <td>
                            <!-- Aquí está el contenedor flex corregido con los márgenes en los botones -->
                            <div class="d-flex flex-wrap">
                                <a asp-page="./Detalle"
                                   asp-route-id="@personal.IdPersonal"
                                   class="btn btn-sm btn-outline-primary me-2 mb-2">Ver</a>

                                <a asp-page="./Editar"
                                   asp-route-id="@personal.IdPersonal"
                                   class="btn btn-sm btn-outline-secondary mb-2">Editar</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>