@page "{id:int}"
@model Bellissimo.Web.Pages.Personal.EditarModel
@{
    ViewData["Title"] = "Editar Empleado";
}

<div class="container-fluid mx-auto py-4 contenedor-ajustable">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Editar Empleado <span class="text-muted fs-4">#@Model.Empleado.IdPersonal</span></h1>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger">@Model.Error</div>

        <a asp-page="./Index" class="btn btn-outline-secondary">
            Regresar
        </a>
    }
    else
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold">
                Datos Generales
            </div>
            <div class="card-body">
                <form method="post" class="row g-3">
                    <input type="hidden" asp-for="Empleado.IdPersonal" />

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="col-md-6">
                        <label asp-for="Empleado.Nombre" class="form-label"></label>
                        <input asp-for="Empleado.Nombre" class="form-control" />
                        <span asp-validation-for="Empleado.Nombre" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Empleado.ApellidoPaterno" class="form-label">Apellido paterno</label>
                        <input asp-for="Empleado.ApellidoPaterno" class="form-control" />
                        <span asp-validation-for="Empleado.ApellidoPaterno" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Empleado.ApellidoMaterno" class="form-label">Apellido materno</label>
                        <input asp-for="Empleado.ApellidoMaterno" class="form-control" />
                        <span asp-validation-for="Empleado.ApellidoMaterno" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Empleado.Telefono" class="form-label">Teléfono</label>
                        <input asp-for="Empleado.Telefono" class="form-control" />
                        <span asp-validation-for="Empleado.Telefono" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Empleado.IdPuesto" class="form-label">Puesto</label>
                        <select asp-for="Empleado.IdPuesto" asp-items="Model.ListaPuestos" class="form-select">
                            <option value="0">Seleccione un puesto...</option>
                        </select>
                        <span asp-validation-for="Empleado.IdPuesto" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Empleado.SueldoBase" class="form-label">Sueldo base semanal</label>
                        <input asp-for="Empleado.SueldoBase" type="number" step="0.01" min="0.01" class="form-control" />
                        <span asp-validation-for="Empleado.SueldoBase" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input asp-for="Empleado.Activo" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="Empleado.Activo" class="form-check-label">Empleado activo (desactivar para baja lógica)</label>
                        </div>
                    </div>

                    <div class="col-12 mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-outline-primary">
                            Guardar cambios
                        </button>
                        <a asp-page="/Personal/Index" class="btn btn-outline-secondary">
                            Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Clave Personal del Checador</span>
                @if (Model.Empleado.TieneClave)
                {
                    <span class="badge bg-success">Clave asignada</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">Sin clave asignada</span>
                }
            </div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.MensajeClave))
                {
                    <div class="alert alert-success">@Model.MensajeClave</div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ErrorClave))
                {
                    <div class="alert alert-danger">@Model.ErrorClave</div>
                }

                <form method="post" asp-page-handler="AsignarClave" class="row g-3 align-items-end">
                    <input type="hidden" asp-for="Empleado.IdPersonal" />

                    <div class="col-md-6">
                        <label asp-for="NuevaClave" class="form-label">
                            @(Model.Empleado.TieneClave ? "Nueva clave (4 a 8 dígitos)" : "Asignar clave (4 a 8 dígitos)")
                        </label>
                        <input asp-for="NuevaClave"
                               type="password"
                               inputmode="numeric"
                               maxlength="8"
                               class="form-control"
                               placeholder="Ej. 1234" />
                        <div class="form-text">
                            El empleado usará su número (#@Model.Empleado.IdPersonal) y esta clave para registrar entradas y salidas.
                        </div>
                    </div>

                    <div class="col-md-6">
                        <button type="submit" class="btn btn-primary">
                            @(Model.Empleado.TieneClave ? "Actualizar clave" : "Asignar clave")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}