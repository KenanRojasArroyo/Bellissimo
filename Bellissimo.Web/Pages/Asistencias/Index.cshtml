@page
@model Bellissimo.Web.Pages.Asistencias.IndexModel
@{
    ViewData["Title"] = "Control de Asistencias";
}

<div class="container-fluid mx-auto py-4 contenedor-ajustable">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="mb-0">Control de Asistencias</h1>
        <div class="d-flex gap-2">
            <a asp-page="./Reporte" class="btn btn-outline-primary">
                Reporte Diario
            </a>
            <a asp-page="./Nuevo" class="btn btn-primary">
                Captura Manual
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger">@Model.Error</div>
    }

    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="alert alert-success">@mensaje</div>
    }

    <form method="get" class="row g-2 align-items-end mb-4">
        <div class="col-md-4">
            <label asp-for="IdEmpleado" class="form-label">Empleado</label>
            <select asp-for="IdEmpleado" asp-items="Model.ListaEmpleados" class="form-select">
                <option value="">Todos los empleados</option>
            </select>
        </div>
        <div class="col-md-2">
            <label asp-for="Desde" class="form-label">Desde</label>
            <input asp-for="Desde" type="date" class="form-control" />
        </div>
        <div class="col-md-2">
            <label asp-for="Hasta" class="form-label">Hasta</label>
            <input asp-for="Hasta" type="date" class="form-control" />
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-fill">Filtrar</button>
            <a asp-page="./Index" class="btn btn-outline-secondary flex-fill">Limpiar</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Empleado</th>
                    <th>Entrada</th>
                    <th>Salida Comida</th>
                    <th>Regreso Comida</th>
                    <th>Salida</th>
                    <th>Método</th>
                    <th>Corregido por</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ListaAsistencias)
                {
                    <tr>
                        <td class="fw-semibold">@item.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@item.NombreEmpleado</td>
                        <td>@(item.Entrada?.ToString("HH:mm") ?? "-")</td>
                        <td>@(item.SalidaComida?.ToString("HH:mm") ?? "-")</td>
                        <td>@(item.RegresoComida?.ToString("HH:mm") ?? "-")</td>
                        <td>@(item.Salida?.ToString("HH:mm") ?? "-")</td>
                        <td>
                            @if (item.Metodo == "Manual")
                            {
                                <span class="badge bg-warning text-dark">Manual</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark">@item.Metodo</span>
                            }
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(item.NombreModificadoPor) ? "-" : item.NombreModificadoPor)</td>
                        <td>
                            @if (!item.SemanaCerrada)
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    <a asp-page="./Editar"
                                       asp-route-id="@item.IdRegistro"
                                       class="btn btn-sm btn-outline-secondary">Corregir</a>

                                    <a asp-page="./Eliminar"
                                       asp-route-id="@item.IdRegistro"
                                       class="btn btn-sm btn-outline-danger">Eliminar</a>
                                </div>
                            }
                            else
                            {
                                <span class="badge bg-dark">Semana cerrada</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>