@page
@model Bellissimo.Web.Pages.Asistencias.ReporteModel
@{
    ViewData["Title"] = "Reporte Diario de Asistencia";
}

<div class="container-fluid mx-auto py-4 contenedor-ajustable">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Reporte Diario de Asistencia</h1>
        <a asp-page="./Index" class="btn btn-outline-secondary">
            Regresar a Asistencias
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger">@Model.Error</div>
    }

    <form method="get" class="row g-2 align-items-end mb-4">
        <div class="col-md-4">
            <label asp-for="IdEmpleado" class="form-label">Empleado</label>
            <select asp-for="IdEmpleado" asp-items="Model.ListaEmpleados" class="form-select">
                <option value="">Todos los empleados</option>
            </select>
        </div>
        <div class="col-md-2">
            <label asp-for="Desde" class="form-label">Desde</label>
            <input asp-for="Desde" type="date" class="form-control" />
        </div>
        <div class="col-md-2">
            <label asp-for="Hasta" class="form-label">Hasta</label>
            <input asp-for="Hasta" type="date" class="form-control" />
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-fill">Consultar</button>
            <a asp-page="./Reporte" class="btn btn-outline-secondary flex-fill">Limpiar</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Empleado</th>
                    <th>Entrada</th>
                    <th>Salida</th>
                    <th>Horas Pres.</th>
                    <th>Comida (min)</th>
                    <th>Comida Extra</th>
                    <th>Retardo (min)</th>
                    <th>Salida Temp.</th>
                    <th>Extra (min)</th>
                    <th>Método</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fila in Model.Filas)
                {
                    <tr>
                        <td class="fw-semibold">@fila.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@fila.Empleado</td>
                        <td>@(fila.Entrada?.ToString(@"hh\:mm") ?? "-")</td>
                        <td>@(fila.Salida?.ToString(@"hh\:mm") ?? "-")</td>
                        <td class="fw-semibold">@fila.HorasPresentes.ToString("0.00")</td>
                        <td>@fila.MinComida</td>
                        <td class="@(fila.MinComidaExtra > 0 ? "text-danger fw-semibold" : "")">@fila.MinComidaExtra</td>
                        <td class="@(fila.MinRetardo > 0 ? "text-danger fw-semibold" : "")">@fila.MinRetardo</td>
                        <td class="@(fila.MinSalidaTemprana > 0 ? "text-warning fw-semibold" : "")">@fila.MinSalidaTemprana</td>
                        <td class="@(fila.MinExtra > 0 ? "text-success fw-semibold" : "")">@fila.MinExtra</td>
                        <td>@fila.Metodo</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>