@page
@model Bellissimo.Web.Pages.RegistroEntradas.RegistroRegresoComidaModel
@{
    ViewData["Title"] = "Registro de Regreso de Comida";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            <h1 class="mb-4">Registro de Regreso de Comida</h1>

            @if (!string.IsNullOrEmpty(Model.MensajeExito))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @Model.MensajeExito
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }

            <div class="card shadow-sm p-4">
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger text-start"></div>

                        <div class="mb-3 text-start">
                            <label asp-for="IdEmpleado" class="form-label fw-semibold">Número de empleado</label>
                            <input asp-for="IdEmpleado"
                                   type="number"
                                   min="1"
                                   class="form-control form-control-lg text-center fs-3"
                                   placeholder="Ej. 1"
                                   inputmode="numeric"
                                   autofocus
                                   autocomplete="off" />
                            <span asp-validation-for="IdEmpleado" class="text-danger d-block mt-1"></span>
                        </div>

                        <div class="mb-4 text-start">
                            <label asp-for="Clave" class="form-label fw-semibold">Clave personal (4 a 8 dígitos)</label>
                            <input asp-for="Clave"
                                   type="password"
                                   class="form-control form-control-lg text-center fs-3"
                                   placeholder="••••"
                                   inputmode="numeric"
                                   maxlength="8"
                                   oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 8);"
                                   autocomplete="off" />
                            <span asp-validation-for="Clave" class="text-danger d-block mt-1"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg py-3 fs-3 fw-bold">
                                Registrar Regreso
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="mt-4 text-center">
                <a asp-page="/RegistroEntradas/Index" class="btn btn-outline-secondary px-4"> Regresar </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}