@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="container py-4">
    <section class="hero">
        <h1>Bienvenido a Bellissimo</h1>
    </section>

    <div class="row g-3 mt-2">
        <!-- Entradas -->
        <div class="col-sm-6 col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title">Entradas</h5>
                        <p class="card-text small text-muted">Registra las entradas y regresos de comida del personal.</p>
                    </div>
                    <div class="d-flex flex-wrap gap-1 mt-2">
                        <a asp-page="/RegistroEntradas/Index" class="btn btn-primary btn-sm">General</a>
                        <a asp-page="/RegistroEntradas/RegistroEntrada" class="btn btn-outline-primary btn-sm">Entrada</a>
                        <a asp-page="/RegistroEntradas/RegistroRegresoComida" class="btn btn-outline-primary btn-sm">Regreso</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Salidas -->
        <div class="col-sm-6 col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title">Salidas</h5>
                        <p class="card-text small text-muted">Registra las salidas de turno y salidas a comida.</p>
                    </div>
                    <div class="d-flex flex-wrap gap-1 mt-2">
                        <a asp-page="/RegistroSalidas/Index" class="btn btn-primary btn-sm">General</a>
                        <a asp-page="/RegistroSalidas/RegistroSalida" class="btn btn-outline-primary btn-sm">Salida</a>
                        <a asp-page="/RegistroSalidas/RegistroSalidaComida" class="btn btn-outline-primary btn-sm">Comida</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Asistencias -->
        <div class="col-sm-6 col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title">Asistencias</h5>
                        <p class="card-text small text-muted">Consulta el historial y control de asistencias.</p>
                    </div>
                    <div class="mt-2">
                        <a asp-page="/Asistencias/Index" class="btn btn-primary btn-sm">Ir a Asistencias</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ausencias -->
        <div class="col-sm-6 col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title">Ausencias</h5>
                        <p class="card-text small text-muted">Gestiona faltas, permisos e incapacidades.</p>
                    </div>
                    <div class="mt-2">
                        <a asp-page="/Ausencias/Index" class="btn btn-primary btn-sm">Ir a Ausencias</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pagos -->
        <div class="col-sm-6 col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title">Pagos</h5>
                        <p class="card-text small text-muted">Revisa y administra los pagos al personal.</p>
                    </div>
                    <div class="mt-2">
                        <a asp-page="/Pagos/Index" class="btn btn-primary btn-sm">Ir a Pagos</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Personal -->
        <div class="col-sm-6 col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title">Personal</h5>
                        <p class="card-text small text-muted">Administra el directorio e información de empleados.</p>
                    </div>
                    <div class="mt-2">
                        <a asp-page="/Personal/Index" class="btn btn-primary btn-sm">Ir a Personal</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Puestos -->
        <div class="col-sm-6 col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title">Puestos</h5>
                        <p class="card-text small text-muted">Configura los cargos, roles y tabuladores.</p>
                    </div>
                    <div class="mt-2">
                        <a asp-page="/Puestos/Index" class="btn btn-primary btn-sm">Ir a Puestos</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>